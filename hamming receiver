#include <stdio.h>
#include <math.h>

int main()
{
    int code[40];
    int original[40];
    int total;
    int r = 0;
    int i, j;
    int count;
    int error = 0;
    int syndrome[10];
    int pos;
    char ch;
    FILE *fp;

    fp = fopen("hamming.txt", "r");

    if(fp == NULL)
    {
        printf("Cannot open hamming.txt\n");
        return 0;
    }

    fscanf(fp, "%d", &total);

    for(i = 1; i <= total; i++)
    {
        fscanf(fp, "%d", &code[i]);
        original[i] = code[i];
    }

    fclose(fp);

    printf("---------------- HAMMING CODE RECEIVER ----------------\n\n");

    printf("Received Hamming Code : ");

    for(i = total; i >= 1; i--)
        printf("%d", code[i]);

    printf("\n");

    while(pow(2, r) < (total + 1))
        r++;

    printf("\nChecking Parity Bits (Even Parity)\n\n");

    error = 0;

    for(i = 0; i < r; i++)
    {
        int p = (int)pow(2, i);
        count = 0;

        printf("Checking P%d (checking indices where bit %d is set):\n  ", p, i + 1);

        int first = 1;

        for(j = 1; j <= total; j++)
        {
            if(j & p)
            {
                if(!first)
                    printf(" ");

                printf("%dval:%d", j, code[j]);
                first = 0;

                if(code[j] == 1)
                    count++;
            }
        }

        syndrome[i] = count % 2;

        printf("\n  Result: P%d = %d\n\n", p, syndrome[i]);

        if(syndrome[i] == 1)
            error += p;
    }

    if(error == 0)
    {
        printf("No Error Detected.\n");
    }
    else
    {
        printf("Error Detected at Bit Position : %d\n", error);
    }

    printf("\nOriginal Data Bits : ");

    for(i = total; i >= 1; i--)
    {
        if(i != 1 && i != 2 && i != 4 && i != 8 && i != 16)
            printf("%d", code[i]);
    }

    printf("\n");

    printf("\nDo you want to introduce an error? (Y/N): ");
    scanf(" %c", &ch);

    if(ch == 'Y' || ch == 'y')
    {
        printf("Enter bit position to flip (1 to %d): ", total);
        scanf("%d", &pos);

        int internal = total - pos + 1;

        code[internal] = !code[internal];

        printf("\nBit %d has been flipped.\n", pos);

        printf("\nCorrupted Hamming Code : ");

        for(i = total; i >= 1; i--)
            printf("%d", code[i]);

        printf("\n");
        printf("\nChecking Parity Bits Again (Even Parity)\n\n");

        error = 0;

        for(i = 0; i < r; i++)
        {
            int p = (int)pow(2, i);
            count = 0;

            printf("Checking P%d (checking indices where bit %d is set):\n  ", p, i + 1);

            int first = 1;

            for(j = 1; j <= total; j++)
            {
                if(j & p)
                {
                    if(!first)
                        printf(" ");

                    printf("%dval:%d", j, code[j]);
                    first = 0;

                    if(code[j] == 1)
                        count++;
                }
            }

            syndrome[i] = count % 2;

            printf("\n  Result: P%d = %d\n\n", p, syndrome[i]);

            if(syndrome[i] == 1)
                error += p;
        }

        printf("Syndrome (Binary) : ");

        for(i = r - 1; i >= 0; i--)
            printf("%d", syndrome[i]);

        printf("\n");

        printf("Syndrome (Decimal): %d\n", error);

        if(error == 0)
        {
            printf("\nNo Error Detected.\n");
        }
        else
        {
            printf("\nError Detected at Bit Position : %d\n", error);

            code[error] = !code[error];

            printf("\nCorrected Hamming Code : ");

            for(i = total; i >= 1; i--)
                printf("%d", code[i]);

            printf("\n");

            printf("\nOriginal Data Bits : ");

            for(i = total; i >= 1; i--)
            {
                if(i != 1 && i != 2 && i != 4 && i != 8 && i != 16)
                    printf("%d", code[i]);
            }

            printf("\n");
        }
    }

    return 0;
}
