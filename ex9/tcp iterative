#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>

int main()
{
    int server_fd, client_fd;
    struct sockaddr_in server, client;
    socklen_t len;
    char str[100];
    int choice, i, n;

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(8080);

    bind(server_fd, (struct sockaddr *)&server, sizeof(server));
    listen(server_fd, 5);

    printf("Server waiting...\n");

    len = sizeof(client);
    client_fd = accept(server_fd, (struct sockaddr *)&client, &len);

    while (1)
    {
        recv(client_fd, &choice, sizeof(choice), 0);

        if (choice == 4)
            break;

        recv(client_fd, str, sizeof(str), 0);

        n = strlen(str);

        if (choice == 1)
        {
            for (i = 0; i < n / 2; i++)
            {
                char temp = str[i];
                str[i] = str[n - i - 1];
                str[n - i - 1] = temp;
            }

            send(client_fd, str, sizeof(str), 0);
        }
        else if (choice == 2)
        {
            send(client_fd, &n, sizeof(n), 0);
        }
        else if (choice == 3)
        {
            int count = 0;

            for (i = 0; i < n; i++)
            {
                if (str[i] == 'a' || str[i] == 'e' ||
                    str[i] == 'i' || str[i] == 'o' ||
                    str[i] == 'u' || str[i] == 'A' ||
                    str[i] == 'E' || str[i] == 'I' ||
                    str[i] == 'O' || str[i] == 'U')
                {
                    count++;
                }
            }

            send(client_fd, &count, sizeof(count), 0);
        }
    }

    close(client_fd);
    close(server_fd);

    return 0;
}
