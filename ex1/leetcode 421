#include <stdlib.h>

// Define the Trie Node structure
typedef struct TrieNode {
    struct TrieNode* children[2];
} TrieNode;

// Helper function to create a new Trie node
TrieNode* createNode() {
    TrieNode* node = (TrieNode*)calloc(1, sizeof(TrieNode));
    return node;
}

// Helper function to insert a number into the Trie bit by bit
void insert(TrieNode* root, int num) {
    TrieNode* curr = root;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        if (!curr->children[bit]) {
            curr->children[bit] = createNode();
        }
        curr = curr->children[bit];
    }
}

// Helper function to find the maximum XOR for a given number
int findMaxXORForNum(TrieNode* root, int num) {
    TrieNode* curr = root;
    int maxXOR = 0;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        int toggledBit = 1 - bit; // We want the opposite bit to maximize XOR
        
        if (curr->children[toggledBit]) {
            maxXOR |= (1 << i); // If opposite bit exists, it contributes to XOR
            curr = curr->children[toggledBit];
        } else {
            curr = curr->children[bit]; // Otherwise, we have to take the same bit
        }
    }
    return maxXOR;
}

// Free memory to prevent memory leaks
void freeTrie(TrieNode* root) {
    if (!root) return;
    freeTrie(root->children[0]);
    freeTrie(root->children[1]);
    free(root);
}

int findMaximumXOR(int* nums, int numsSize) {
    if (numsSize < 2) return 0;
    
    TrieNode* root = createNode();
    int globalMaxXOR = 0;
    
    // Insert the first number
    insert(root, nums[0]);
    
    // For each subsequent number, find its max XOR with already inserted numbers
    for (int i = 1; i < numsSize; i++) {
        int currentMax = findMaxXORForNum(root, nums[i]);
        if (currentMax > globalMaxXOR) {
            globalMaxXOR = currentMax;
        }
        insert(root, nums[i]);
    }
    
    freeTrie(root);
    return globalMaxXOR;
}
