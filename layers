void packetlayer()
{
    int i,j;
    int remain,pad,data;
    printf("\n\n====================== PACKET FORMATION ======================\n");
    totalpackets = totalbits / packetSize;
    if(totalbits % packetSize != 0)
        totalpackets++;
    packet = (char**)malloc(totalpackets * sizeof(char*));
    if(packet==NULL){ printf("\nMemory allocation failed."); exit(1); }
    for(i=0;i<totalpackets;i++)
    {
        packet[i] = (char*)malloc((packetSize+1) * sizeof(char));
        if(packet[i]==NULL){ printf("\nMemory allocation failed."); exit(1); }
    }
    printf("\nTotal Binary Size : %d Bits",totalbits);
    printf("\nPacket Size       : %d Bits",packetSize);
    printf("\nTotal Packets     : %d\n",totalpackets);
    for(i=0;i<totalpackets;i++)
    {
        data=0;
        for(j=0;j<packetSize;j++)
        {
            if((i*packetSize+j)<totalbits)
            {
                packet[i][j]=finaldata[i*packetSize+j];
                data++;
            }
            else
            {
                packet[i][j]='0';
            }
        }
        packet[i][packetSize]='\0';
        printf("\n--------------------------------");
        printf("\nPacket %d",i+1);
        printf("\n%s",packet[i]);
        if(data<packetSize)
        {
            pad=packetSize-data;
            printf("\n");
            printf("\nOnly %d Data Bits Available.",data);
            printf("\nRemaining %d Bits are Padded with 0.",pad);
            printf("\nError Code : %s",errorcode);
        }
        printf("\n--------------------------------");
    }
    remain=totalbits%packetSize;
    printf("\n\n====================== PACKET CALCULATION ======================\n");
    printf("\nTotal Binary Bits : %d",totalbits);
    printf("\nPacket Size       : %d",packetSize);
    printf("\nPackets Created   : %d",totalpackets);
    if(remain!=0)
    {
        printf("\nRemaining Bits    : %d",remain);
        printf("\nPadding Bits      : %d",packetSize-remain);
    }
    else
    {
        printf("\nRemaining Bits    : 0");
        printf("\nPadding Bits      : 0");
    }
    printf("\n");
}
void framelayer()
{
    int i,j,k;
    int framecount=0;
    int framesPerPacket;
    int bitsavail,copylen;
    printf("\n\n====================== FRAME FORMATION ======================\n");
    printf("\nFrame Size : %d Bits",frameSize);
    framesPerPacket = packetSize / frameSize;
    if(packetSize % frameSize != 0)
        framesPerPacket++;
    totalframes = totalpackets * framesPerPacket;
    frame = (char**)malloc(totalframes * sizeof(char*));
    if(frame==NULL){ printf("\nMemory allocation failed."); exit(1); }
    for(i=0;i<totalframes;i++)
    {
        frame[i] = (char*)malloc((frameSize+1) * sizeof(char));
        if(frame[i]==NULL){ printf("\nMemory allocation failed."); exit(1); }
    }
    for(i=0;i<totalpackets;i++)
    {
        printf("\n\nPacket %d Converted into Frames",i+1);
        for(j=0;j<packetSize;j+=frameSize)
        {
            bitsavail = packetSize - j;
            copylen = (bitsavail<frameSize) ? bitsavail : frameSize;
            for(k=0;k<frameSize;k++)
            {
                if(k<copylen)
                    frame[framecount][k]=packet[i][j+k];
                else
                    frame[framecount][k]='0'; /* pad leftover bits */
            }
            frame[framecount][frameSize]='\0';
            framecount++;
            printf("\n--------------------------------");
            printf("\nFrame %d",framecount);
            printf("\n%s",frame[framecount-1]);
            if(copylen<frameSize)
            {
                printf("\nPadded %d Bits with 0 (end of packet).",frameSize-copylen);
            }
            printf("\n--------------------------------");
        }
    }
    totalframes=framecount;
    printf("\n\nTotal Frames Created : %d",totalframes);
}
