void readfile()
{
    FILE *fp;
    char ch;
    int i = 0;
    char filename[100];
    printf("Enter the file name: ");
    scanf("%99s", filename);
    fp = fopen(filename, "r");
    if (fp == NULL)
    {
        printf("\nFile '%s' not found.", filename);
        exit(0);
    }
    while ((ch = fgetc(fp)) != EOF)
    {
        if (ch != '\n')
        {
            msg[i] = ch;
            i++;
        }
    }

    msg[i] = '\0';
    fclose(fp);
}
void decbin(int n,int bits,char b[])
{
    int i;
    b[bits]='\0';
    for(i=bits-1;i>=0;i--)
    {
        b[i]=(n%2)+'0';
        n=n/2;
    }
}
void chartobin(char ch,char b[])
{
    decbin((unsigned char)ch,8,b);
}
void ipbin(char ip[],char b[])
{
    int a,c,d,e;
    char t[9];
    b[0]='\0';
    sscanf(ip,"%d.%d.%d.%d",&a,&c,&d,&e);
    decbin(a,8,t);
    strcat(b,t);
    decbin(c,8,t);
    strcat(b,t);
    decbin(d,8,t);
    strcat(b,t);
    decbin(e,8,t);
    strcat(b,t);
}
void macbin(char mac[],char b[])
{
    unsigned int m[6];
    int i;
    char t[9];
    b[0]='\0';
    sscanf(mac,"%x:%x:%x:%x:%x:%x",
           &m[0],&m[1],&m[2],&m[3],&m[4],&m[5]);
    for(i=0;i<6;i++)
    {
        decbin(m[i],8,t);
        strcat(b,t);
    }
}

int randomport()
{
    return rand()%50000+1024;
}
int getPositiveInt(const char prompt[])
{
    int value;
    int ok;
    do
    {
        printf("%s",prompt);
        ok = scanf("%d",&value);
        if(ok!=1)
        {
            /* clear bad input from the buffer */
            while(getchar()!='\n');
            value = -1;
        }
        if(value<=0)
            printf("Please enter a positive whole number.\n");
    } while(value<=0);
    return value;
}
