void freeMemory()
{
    int i;
    if(packet!=NULL)
    {
        for(i=0;i<totalpackets;i++) free(packet[i]);
        free(packet);
    }
    if(frame!=NULL)
    {
        for(i=0;i<totalframes;i++) free(frame[i]);
        free(frame);
    }
}
