#include <stdio.h>
#include <string.h>

#define MAX_ROWS 100
#define BITS 7

void toBinary(char ch, int bin[BITS])
{
    int i;
    int value = ch;

    for (i = BITS - 1; i >= 0; i--)
    {
        bin[i] = value % 2;
        value = value / 2;
    }
}

int calculateParity(int bits[], int n)
{
    int i, count = 0;

    for (i = 0; i < n; i++)
    {
        if (bits[i] == 1)
            count++;
    }

    if (count % 2 == 0)
        return 0;
    else
        return 1;
}

void printMatrix(char message[], int matrix[MAX_ROWS][BITS],
                  int rowParity[MAX_ROWS], int colParity[BITS],
                  int cornerParity, int rows)
{
    int i, j;

    printf("\n             B1 B2 B3 B4 B5 B6 B7 | P\n");
    printf("---------------------------------------\n");

    for (i = 0; i < rows; i++)
    {
        printf("%c            ", message[i]);
        for (j = 0; j < BITS; j++)
        {
            printf("%d  ", matrix[i][j]);
        }
        printf("| %d\n", rowParity[i]);
    }

    printf("---------------------------------------\n");
    printf("P            ");
    for (j = 0; j < BITS; j++)
    {
        printf("%d  ", colParity[j]);
    }
    printf("| %d\n", cornerParity);
}

int main()
{
    char message[MAX_ROWS];
    int matrix[MAX_ROWS][BITS];
    int rowParity[MAX_ROWS];
    int colParity[BITS];
    int cornerParity;
    int rows, i, j;

    printf("Enter MESSAGE: ");
    scanf("%s", message);

    rows = strlen(message);

    for (i = 0; i < rows; i++)
    {
        toBinary(message[i], matrix[i]);
    }

    printf("\nCalculating Row Parity Bits (Even Parity)\n");
    for (i = 0; i < rows; i++)
    {
        printf("Row %d (Character '%c'):\n  Bits: ", i + 1, message[i]);
        for (j = 0; j < BITS; j++)
        {
            printf("B%d:%d ", j + 1, matrix[i][j]);
        }
        rowParity[i] = calculateParity(matrix[i], BITS);
        printf("\n  Result: Row Parity = %d\n\n", rowParity[i]);
    }

    printf("Calculating Column Parity Bits (Even Parity)\n");
    for (j = 0; j < BITS; j++)
    {
        int col[MAX_ROWS];
        printf("Column %d (B%d):\n  Bits: ", j + 1, j + 1);

        for (i = 0; i < rows; i++)
        {
            col[i] = matrix[i][j];
            printf("Row%d:%d ", i + 1, col[i]);
        }

        colParity[j] = calculateParity(col, rows);
        printf("\n  Result: Column Parity = %d\n\n", colParity[j]);
    }

    cornerParity = calculateParity(rowParity, rows);

    printf("---------------------------------------\n");
    printf("Final 2D Parity Matrix Layout\n");
    printf("---------------------------------------\n");
    printMatrix(message, matrix, rowParity, colParity, cornerParity, rows);

    return 0;
}
