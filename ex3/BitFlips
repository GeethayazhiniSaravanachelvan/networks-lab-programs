int minBitFlips(int start, int goal) {
    int xor_result = start ^ goal;
    int count = 0;
    
    // Count the number of set bits (1s) in the XOR result
    while (xor_result > 0) {
        // Increment count if the rightmost bit is 1
        count += xor_result & 1;
        // Shift right to check the next bit
        xor_result >>= 1;
    }
    
    return count;
}
