#include <stdio.h>
#include <stdlib.h>

#define MAX_V 26
#define INF 999999

int n;
int adjWeight[MAX_V][MAX_V];
int dist[MAX_V];
int prevNode[MAX_V];
int visited[MAX_V];

/* ---------------- Binary Min-Heap (Priority Queue) ---------------- */
typedef struct { int node, dist; } HeapNode;
HeapNode heap[10000];
int heapSize;

void heapSwap(HeapNode *a, HeapNode *b) { HeapNode t = *a; *a = *b; *b = t; }

void heapPush(int node, int d) {
    heapSize++;
    heap[heapSize].node = node;
    heap[heapSize].dist = d;
    int i = heapSize;
    while (i > 1 && heap[i].dist < heap[i / 2].dist) {
        heapSwap(&heap[i], &heap[i / 2]);
        i /= 2;
    }
}

HeapNode heapPop() {
    HeapNode top = heap[1];
    heap[1] = heap[heapSize];
    heapSize--;
    int i = 1;
    while (1) {
        int l = 2 * i, r = 2 * i + 1, smallest = i;
        if (l <= heapSize && heap[l].dist < heap[smallest].dist) smallest = l;
        if (r <= heapSize && heap[r].dist < heap[smallest].dist) smallest = r;
        if (smallest == i) break;
        heapSwap(&heap[i], &heap[smallest]);
        i = smallest;
    }
    return top;
}

int isHeapEmpty() { return heapSize == 0; }

/* ---------------- Helpers ---------------- */
void distStr(int d, char *out) {
    if (d >= INF) sprintf(out, "INF");
    else sprintf(out, "%d", d);
}

void printPath(int s, int t) {
    int path[MAX_V], cnt = 0, cur = t;
    int i; /* Declared loop variable at the top */

    while (cur != -1) { path[cnt++] = cur; cur = prevNode[cur]; }
    for (i = cnt - 1; i >= 0; i--) {
        printf("%c", 'A' + path[i]);
        if (i > 0) printf(" -> ");
    }
}

/* ---------------- Dijkstra (Greedy, Heap-based) ---------------- */
void dijkstra(int s) {
    int i, v, t; /* Declared all loop variables at the top */
    int step = 0;

    for (i = 0; i < n; i++) { dist[i] = INF; visited[i] = 0; prevNode[i] = -1; }
    dist[s] = 0;
    heapSize = 0;
    heapPush(s, 0);

    printf("\n=======================================================================\n");
    printf("               STEP-BY-STEP DISTANCE LOG TABLE (SOURCE: %c)\n", 'A' + s);
    printf("=======================================================================\n");
    printf("Step   | Extracted Node   | Path Addition        | New Shortest Distance\n");
    printf("-----------------------------------------------------------------------\n");

    while (!isHeapEmpty()) {
        HeapNode top = heapPop();
        int u = top.node;
        if (visited[u]) continue;   /* lazy deletion for stale heap entries */
        visited[u] = 1;
        step++;

        int hasEdge = 0;
        for (v = 0; v < n; v++) {
            if (adjWeight[u][v] == -1) continue;
            hasEdge = 1;
            if (visited[v]) continue;
            int newDist = dist[u] + adjWeight[u][v];
            char oldStr[16];
            distStr(dist[v], oldStr);
            if (newDist < dist[v]) {
                printf("%-6d | %-16c | %d + %d = %-6d| %s -> %d\n",
                       step, 'A' + u, dist[u], adjWeight[u][v], newDist, oldStr, newDist);
                dist[v] = newDist;
                prevNode[v] = u;
                heapPush(v, newDist);
            } else {
                printf("%-6d | %-16c | %d + %d = %-6d| %d >= %d (Ignored)\n",
                       step, 'A' + u, dist[u], adjWeight[u][v], newDist, newDist, dist[v]);
            }
        }
        if (!hasEdge) {
            printf("%-6d | %-16c | %-21s| No Outgoing Edges\n", step, 'A' + u, "-");
        }
    }

    for (v = 0; v < n; v++) {
        if (!visited[v]) {
            step++;
            printf("%-6d | %-16c | %-21s| Unreachable / INF\n", step, 'A' + v, "-");
            visited[v] = 1;
        }
    }

    printf("\n---------------------------------------------------------------------------------------------------\n");
    printf("Source   | Destination   | Next Node to Visit   | Final Distance | Full Path\n");
    printf("---------------------------------------------------------------------------------------------------\n");

    for (t = 0; t < n; t++) {
        if (t == s) {
            printf("%-8c | %-13c | %-21s| Dist: %-8d| ", 'A' + s, 'A' + t, "Self (0)", 0);
            printPath(s, t);
            printf("\n");
        } else if (dist[t] >= INF) {
            printf("%-8c | %-13c | %-21s| Dist: %-8s| No Path\n", 'A' + s, 'A' + t, "None", "INF");
        } else {
            int path[MAX_V], cnt = 0, cur = t;
            while (cur != -1) { path[cnt++] = cur; cur = prevNode[cur]; }
            int nextHop = path[cnt - 2]; /* second element from source side */
            char label[16];
            sprintf(label, "%c (Next Hop)", 'A' + nextHop);
            printf("%-8c | %-13c | %-21s| Dist: %-8d| ", 'A' + s, 'A' + t, label, dist[t]);
            printPath(s, t);
            printf("\n");
        }
    }
    printf("---------------------------------------------------------------------------------------------------\n");
}

/* ---------------- Main / Input Handling ---------------- */
int main() {
    int e;
    int i, j, s; /* Declared all loop variables at the top */

    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter number of edges: ");
    scanf("%d", &e);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            adjWeight[i][j] = -1;

    printf("Enter edges (Source Destination Weight, e.g., A B 5):\n");
    for (i = 1; i <= e; i++) {
        char su, du;
        int w;
        scanf(" %c %c %d", &su, &du, &w);
        while (w < 0) {
            printf("Negative weights not allowed! Re-enter edge %d: ", i);
            scanf(" %c %c %d", &su, &du, &w);
        }
        int u = su - 'A', v = du - 'A';
        adjWeight[u][v] = w;
    }

    for (s = 0; s < n; s++)
        dijkstra(s);

    return 0;
}
