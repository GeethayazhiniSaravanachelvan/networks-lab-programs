#include <stdio.h>
#include <string.h>

#define MAX_ROWS 100
#define BITS 7

int calculateParity(int bits[], int n)
{
    int i, count = 0;

    for (i = 0; i < n; i++)
    {
        if (bits[i] == 1)
            count++;
    }

    if (count % 2 == 0)
        return 0;
    else
        return 1;
}

void printMatrix(int matrix[MAX_ROWS][BITS], int rowParity[MAX_ROWS],
                  int colParity[BITS], int cornerParity, int rows)
{
    int i, j;

    printf("\n             B1 B2 B3 B4 B5 B6 B7 | P\n");
    printf("---------------------------------------\n");

    for (i = 0; i < rows; i++)
    {
        printf("R%-2d          ", i + 1);
        for (j = 0; j < BITS; j++)
        {
            printf("%d  ", matrix[i][j]);
        }
        printf("| %d\n", rowParity[i]);
    }

    printf("---------------------------------------\n");
    printf("P            ");
    for (j = 0; j < BITS; j++)
    {
        printf("%d  ", colParity[j]);
    }
    printf("| %d\n", cornerParity);
}

void runDetailedParityCheck(int matrix[MAX_ROWS][BITS], int rowParity[MAX_ROWS],
                            int colParity[BITS], int rows, int *errorRow, int *errorCol, int secondTime)
{
    int i, j;
    int rowCheck[MAX_ROWS];
    int colCheck[BITS];

    *errorRow = -1;
    *errorCol = -1;

    printf("\nChecking Row Parity (Even Parity)\n");
    for (i = 0; i < rows; i++)
    {
        printf("Row %d \n  Bits: ", i + 1);
        for (j = 0; j < BITS; j++)
        {
            printf("B%d:%d ", j + 1, matrix[i][j]);
        }

        int recomputed = calculateParity(matrix[i], BITS);
        printf("\n  Stored Row Parity P = %d | Recomputed Parity = %d\n", rowParity[i], recomputed);

        if (recomputed == rowParity[i])
        {
            rowCheck[i] = 0;
            printf("  Result: Correct\n\n");
        }
        else
        {
            rowCheck[i] = 1;
            *errorRow = i;
            printf("  Result: Error Detected\n\n");
        }
    }

    if (secondTime)
    {
        printf("Checking Column Parity \n");
    }
    else
    {
        printf("Checking Column Parity (Even Parity)\n");
    }

    for (j = 0; j < BITS; j++)
    {
        int col[MAX_ROWS];
        int recomputed;
        if (j == 1 && !secondTime)
        {
            printf("Column %d (\n  Bits: ", j + 1);
        }
        else
        {
            printf("Column %d \n  Bits: ", j + 1);
        }

        for (i = 0; i < rows; i++)
        {
            col[i] = matrix[i][j];
            printf("R%d:%d ", i + 1, col[i]);
        }

        recomputed = calculateParity(col, rows);
        printf("\n  Stored Column Parity P = %d | Recomputed Parity = %d\n", colParity[j], recomputed);

        if (recomputed == colParity[j])
        {
            colCheck[j] = 0;
            printf("  Result: Correct\n\n");
        }
        else
        {
            colCheck[j] = 1;
            *errorCol = j;
            printf("  Result: Error Detected\n\n");
        }
    }
}

int main()
{
    int matrix[MAX_ROWS][BITS];
    int rowParity[MAX_ROWS];
    int colParity[BITS];
    int cornerParity;
    int rows, i, j;
    int errorRow, errorCol;
    char choice;
    char recovered[MAX_ROWS + 1];
    FILE *fp;

    fp = fopen("parity.txt", "r");
    if (fp == NULL)
    {
        printf("Error: parity.txt not found. Run the sender first.\n");
        return 1;
    }

    fscanf(fp, "%d", &rows);

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < BITS; j++)
        {
            fscanf(fp, "%d", &matrix[i][j]);
        }
        fscanf(fp, "%d", &rowParity[i]);
    }

    for (j = 0; j < BITS; j++)
    {
        fscanf(fp, "%d", &colParity[j]);
    }
    fscanf(fp, "%d", &cornerParity);

    fclose(fp);

    printf("Received Matrix:\n");
    printMatrix(matrix, rowParity, colParity, cornerParity, rows);

    runDetailedParityCheck(matrix, rowParity, colParity, rows, &errorRow, &errorCol, 0);

    if (errorRow == -1 && errorCol == -1)
    {
        printf(" No Error Detected.\n");
    }

    printf("\nDo you want to introduce an error? (Y/N): ");
    scanf(" %c", &choice);

    if (choice == 'Y' || choice == 'y')
    {
        int r, c;
        printf("Enter Row Number (1 to %d): ", rows);
        scanf("%d", &r);
        printf("Enter Column Number (1 to %d): ", BITS);
        scanf("%d", &c);

        if (matrix[r - 1][c - 1] == 1)
            matrix[r - 1][c - 1] = 0;
        else
            matrix[r - 1][c - 1] = 1;

        printf("\nCorrupted Matrix (after introducing error):\n");
        printMatrix(matrix, rowParity, colParity, cornerParity, rows);

        runDetailedParityCheck(matrix, rowParity, colParity, rows, &errorRow, &errorCol, 1);

        if (errorRow != -1 && errorCol != -1)
        {
            printf("Error Detected!\n");
            printf("Intersection Point Foundat Position : Row %d Column %d\n", errorRow + 1, errorCol + 1);

            if (matrix[errorRow][errorCol] == 1)
                matrix[errorRow][errorCol] = 0;
            else
                matrix[errorRow][errorCol] = 1;

            printf("\nCorrected Matrix:\n");
            printMatrix(matrix, rowParity, colParity, cornerParity, rows);
        }
    }

    for (i = 0; i < rows; i++)
    {
        int value = 0;
        for (j = 0; j < BITS; j++)
        {
            value = value * 2 + matrix[i][j];
        }
        recovered[i] = (char)value;
    }
    recovered[rows] = '\0';

    printf("\nRecovered Message : %s\n", recovered);

    return 0;
}
