#include <stdio.h>
#include <math.h>
#include <string.h>

int main()
{
    int data[30], code[40];
    int m, r = 0, total;
    int i, j, k, check;
    FILE *fp;
    char binaryString[100];

    // Input binary string
    printf("Enter binary string: ");
    scanf("%s", binaryString);

    m = strlen(binaryString);

    // Store data bits in reverse order
    for(i = 1; i <= m; i++)
    {
        data[i] = binaryString[m - i] - '0';
    }

    // Calculate number of parity bits
    while(pow(2, r) < (m + r + 1))
        r++;

    total = m + r;

    // ---------------- Placing Data Bits ----------------
    printf("\nPlacing Data Bits\n");

    j = 1;
    k = 1;

    for(i = 1; i <= total; i++)
    {
        if(i == (int)pow(2, j - 1))
        {
            code[i] = 0;
            printf("Index %2d: P%d (Reserved for Parity)\n", i, i);
            j++;
        }
        else
        {
            code[i] = data[k];
            printf("Index %2d: D%d = %d\n", i, k, data[k]);
            k++;
        }
    }

    // ---------------- Calculating Parity Bits ----------------
    printf("\nCalculating Parity Bits (Even Parity)\n");

    for(i = 0; i < r; i++)
    {
        int p = (int)pow(2, i);
        int count = 0;

        printf("Calculating P%d (checking indices where bit %d is set):\n  ", p, i + 1);

        int first = 1;

        for(j = 1; j <= total; j++)
        {
            if(j & p)
            {
                if(j != p)
                {
                    if(!first)
                        printf(" ");

                    printf("%dval:%d", j, code[j]);
                    first = 0;

                    if(code[j] == 1)
                        count++;
                }
            }
        }

        if(count % 2 == 0)
            code[p] = 0;
        else
            code[p] = 1;

        printf("\n  Result: P%d = %d\n\n", p, code[p]);
    }

    // ---------------- Final Combined Array ----------------
    printf("Final Combined Array Layout\n");

    printf("Position:  ");
    for(i = total; i >= 1; i--)
    {
        if((i & (i - 1)) == 0)
        {
            printf("P%d  ", i);
        }
        else
        {
            int d_counter = 0;

            for(check = 1; check <= i; check++)
            {
                if((check & (check - 1)) != 0)
                    d_counter++;
            }

            printf("D%d  ", d_counter);
        }
    }

    printf("\nBit Value: ");
    for(i = total; i >= 1; i--)
    {
        printf("%-4d", code[i]);
    }

    printf("\n\n");
    printf("Added %d parity bits. Total block size: %d bits.\n", r, total);

    // ---------------- Save to File ----------------
    fp = fopen("hamming.txt", "w");

    if(fp != NULL)
    {
        fprintf(fp, "%d\n", total);

        for(i = 1; i <= total; i++)
            fprintf(fp, "%d ", code[i]);

        fclose(fp);
    }

    printf("\nData stored successfully in hamming.txt\n");

    return 0;
}
